# Hydrogen storefront environment — copy to .env and fill in real values.
# Do NOT commit the real .env file (it's gitignored).

# Session secret for cookie signing — generate with: openssl rand -hex 32
SESSION_SECRET="replace-me"

# Your Shopify store domain (no protocol, no trailing slash)
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"

# Storefront API token — from Shopify Admin → Settings → Apps and sales
# channels → Headless → API access tokens
PUBLIC_STOREFRONT_API_TOKEN=""

# Storefront ID — from Shopify Admin → Hydrogen channel → storefront settings
PUBLIC_STOREFRONT_ID=""

# Checkout domain — for the hosted Shopify checkout
PUBLIC_CHECKOUT_DOMAIN="checkout.shopify.com"

# Customer Account API — from Shopify Admin → Headless channel → Customer
# Account API → API credentials
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# Optional — Resend API key for the /api/quote-request email forwarder.
# Without this, quote submissions are logged to the server console only.
# Sign up at https://resend.com (3k emails/mo free tier).
# PRIVATE_RESEND_API_KEY=""
