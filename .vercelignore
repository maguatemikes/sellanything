# Files Vercel doesn't need to upload (smaller, faster deploys).
# These DON'T affect Oxygen — Oxygen ignores .vercelignore.

# Build outputs (Vercel runs the build itself)
dist
.cache
.react-router
.mf

# Local dev / IDE
.shopify
.claude
.cursor
.vscode

# Source maps + bundle analyzer artifacts
**/*.map
dist/server/server-bundle-analyzer.html

# Local image staging (when applicable)
imports

# Misc
.DS_Store
*.log
